{
  "name": "@rsl/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker: schedulers, pollers, outbox dispatcher, checkers and maintenance jobs.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:verify": "tsx --env-file-if-exists=../../.env test/verify-worker.ts"
  },
  "dependencies": {
    "@rsl/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
