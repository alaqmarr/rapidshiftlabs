{
  "name": "@rsl/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic domain core: bounded contexts (domain + application + infrastructure), shared kernel and the SQLite/libSQL data layer.",
  "exports": {
    "./kernel": "./src/shared/kernel/index.ts",
    "./config": "./src/shared/config/index.ts",
    "./db": "./src/shared/infrastructure/db/index.ts",
    "./crypto": "./src/shared/infrastructure/crypto/index.ts",
    "./events": "./src/shared/infrastructure/events/index.ts",
    "./webhooks": "./src/shared/infrastructure/webhooks/index.ts",
    "./container": "./src/container.ts",
    "./identity": "./src/modules/identity/index.ts",
    "./clients": "./src/modules/clients/index.ts",
    "./contracts": "./src/modules/contracts/index.ts",
    "./billing": "./src/modules/billing/index.ts",
    "./entitlement": "./src/modules/entitlement/index.ts",
    "./fleet": "./src/modules/fleet/index.ts",
    "./monitoring": "./src/modules/monitoring/index.ts",
    "./support": "./src/modules/support/index.ts",
    "./analytics": "./src/modules/analytics/index.ts",
    "./vault": "./src/modules/vault/index.ts",
    "./releases": "./src/modules/releases/index.ts",
    "./api-platform": "./src/modules/api-platform/index.ts",
    "./embeds": "./src/modules/embeds/index.ts",
    "./notifications": "./src/modules/notifications/index.ts",
    "./settings": "./src/modules/settings/index.ts",
    "./audit": "./src/modules/audit/index.ts",
    "./openapi": "./src/shared/openapi/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fileParallelism=false",
    "check:architecture": "vitest run test/boundaries.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.core.config.ts && drizzle-kit generate --config drizzle.analytics.config.ts && drizzle-kit generate --config drizzle.metrics.config.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.3.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.0",
    "nodemailer": "^10.1.0",
    "react": "19.3.0",
    "ssh2": "^1.17.0",
    "ua-parser-js": "^2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19",
    "@types/ssh2": "^1.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
